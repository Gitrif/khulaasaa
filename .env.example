# ==============================================================================
# KHULAASAA PRODUCTION CONFIGURATION (SUPABASE + HOSTINGER VPS)
# ==============================================================================

# 1. Admin console credentials
EDITOR_USERNAME=editor
EDITOR_PASSWORD=changeme

# 2. Database Storage (SQLite fallback for local dev/testing)
KHULAASAA_DB_PATH=data/khulaasaa.db

# 3. Supabase Cloud PostgreSQL (Project: qusyunslesnyzbzjljyk | Region: aws-0-ap-southeast-2)
# Primary Connection: Transaction Pooler (Port 6543) - handles hundreds of concurrent web requests cleanly
DATABASE_URL=postgresql://postgres.qusyunslesnyzbzjljyk:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres

# Direct Connection (Port 5432 - Used for schema migrations / CLI):
DATABASE_DIRECT_URL=postgresql://postgres.qusyunslesnyzbzjljyk:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# Supabase API & Cloud Storage Configuration (Project: qusyunslesnyzbzjljyk)
SUPABASE_URL=https://qusyunslesnyzbzjljyk.supabase.co
# Modern Supabase API Keys (New Standard):
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY_HERE
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY_HERE
# Legacy API Key alias (backward compatibility):
SUPABASE_KEY=sb_secret_YOUR_KEY_HERE


# Application Domain URL
APP_URL=https://khulaasaa.tech

# hooks85 Platform Integration (Unified Auth & Payment Gateway)
HOOKS85_URL=https://app.hooks85.com
HOOKS85_GATEWAY_URL=http://gateway_saas:8000

# Telegram Alert Bot Configuration (Optional default credentials)
# Get a bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=khulaasaa_bot
# Your personal or group chat ID (get via @userinfobot on Telegram)
TELEGRAM_CHAT_ID=

# Viber Bot Configuration (Optional)
# Create a bot at https://partners.viber.com to get your App Key (X-Viber-Auth-Token)
VIBER_BOT_TOKEN=
VIBER_BOT_NAME=Khulaasaa
VIBER_BOT_AVATAR=https://khulaasaa.tech/static/logos/khulaasaa.png
VIBER_WEBHOOK_URL=https://khulaasaa.tech/webhook/viber
