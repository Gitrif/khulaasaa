# Admin console credentials
EDITOR_USERNAME=editor
EDITOR_PASSWORD=changeme

# Database Storage (SQLite for local dev/testing; Supabase PostgreSQL for deployment)
KHULAASAA_DB_PATH=data/khulaasaa.db

# Supabase Cloud PostgreSQL (Set for Production Deployment to prevent local server disk filling up)
# Obtain from Supabase Project Settings -> Database -> Connection String (URI)
# Use Transaction Pooler port 6543 for serverless/high concurrency, or direct port 5432
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# SUPABASE_DB_URL is an alias for DATABASE_URL
# SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase API & Storage Configuration (Optional for cloud media and REST API)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_KEY=[YOUR-ANON-OR-SERVICE-ROLE-KEY]


# Application Domain URL
APP_URL=https://khulaasaa.tech

# hooks85 Platform Integration (Unified Auth & Payment Gateway)
HOOKS85_URL=https://app.hooks85.com
HOOKS85_GATEWAY_URL=http://gateway_saas:8000

# Telegram Alert Bot Configuration (Optional default credentials)
# Get a bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=khulaasaa_bot
# Your personal or group chat ID (get via @userinfobot on Telegram)
TELEGRAM_CHAT_ID=

# Viber Bot Configuration (Optional)
# Create a bot at https://partners.viber.com to get your App Key (X-Viber-Auth-Token)
VIBER_BOT_TOKEN=
VIBER_BOT_NAME=Khulaasaa
VIBER_BOT_AVATAR=https://khulaasaa.tech/static/logos/khulaasaa.png
VIBER_WEBHOOK_URL=https://khulaasaa.tech/webhook/viber
